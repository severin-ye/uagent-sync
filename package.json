{
  "name": "uagent-sync",
  "version": "2.1.0",
  "description": "Cross-device agent workspace sync for OpenCode, Codex, and DeepSeek Harness",
  "type": "module",
  "main": "dist/plugin.js",
  "bin": {
    "opencode-sync": "dist/cli.js",
    "uagent-sync": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "hooks",
    "data",
    ".codex-plugin",
    ".claude-plugin",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/generate-dashboard-i18n.mjs && node scripts/copy-dashboard.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node --import tsx --test test/dashboard-browser.e2e.ts",
    "cli": "tsx src/cli.ts",
    "test": "node scripts/run-tests.mjs",
    "clean": "rimraf dist",
    "pack": "npm run clean && npm run build && npm pack",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "smol-toml": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@opencode-ai/plugin": "^1.18.15",
    "@types/node": "^22.0.0",
    "playwright": "^1.62.1",
    "rimraf": "^5.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
