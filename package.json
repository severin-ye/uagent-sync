{
  "name": "opencode-sync-mcp-server",
  "version": "1.1.0",
  "description": "opencode plugin for syncing opencode workspace configuration across devices",
  "type": "module",
  "main": "dist/plugin.js",
  "bin": {
    "opencode-sync": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "test": "node scripts/run-tests.mjs",
    "clean": "rimraf dist",
    "pack": "npm run clean && npm run build && npm pack",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags",
    "release:major": "npm version major && git push --follow-tags"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.18.15",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "rimraf": "^5.0.0"
  }
}
