{
  "name": "uagent-sync-dsh",
  "version": "3.0.0",
  "description": "U同步 / Uagent Sync — cross-device workspace sync for DeepSeek Harness: backup, restore, and ecosystem update via the uagent-sync CLI.",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "dsh": "0.1.0-rc.6 || 0.2.1-rc.5"
  },
  "files": [
    "index.js",
    "lib/cli.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.1.0-rc.6": "unknown",
        "0.2.1-rc.4": "unknown",
        "0.2.2-alpha.2": "unknown",
        "0.2.1-rc.5": "unknown"
      }
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "sync",
    "backup",
    "restore",
    "workspace"
  ],
  "license": "MIT",
  "repository": "https://github.com/severin-ye/uagent-sync",
  "dependencies": {
    "@deepseek-ai/schemastery": "*",
    "uagent-sync": "3.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  }
}
